# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=instant_msg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Backend API Configuration
BACKEND_PORT=5000
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=/app/uploads

# XMPP (ejabberd) Configuration
XMPP_DOMAIN=localhost
XMPP_WS_URL=ws://localhost:5280/ws
EJABBERD_ADMINS=admin@localhost
EJABBERD_USERS=admin@localhost:your_secure_admin_password_here

# Storage Configuration ('s3' or 'local')
STORAGE_PROVIDER=local
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
# AWS_S3_PUBLIC_URL=https://your-custom-cdn.com
# AWS_S3_ENDPOINT=
